# Ruta ABSOLUTA a la raiz de tu boveda de Obsidian.
# Es el unico limite de confianza del servidor: todo acceso queda confinado aqui.
# Windows (usa doble barra invertida o barra normal):
#   OBSIDIAN_VAULT_PATH=C:\Users\<TU_USUARIO>\Documents\MiBoveda
# macOS / Linux:
#   OBSIDIAN_VAULT_PATH=/home/<tu_usuario>/Documents/MiBoveda
OBSIDIAN_VAULT_PATH=

# Nivel de log opcional: error | warn | info | debug (por defecto: info)
LOG_LEVEL=info
